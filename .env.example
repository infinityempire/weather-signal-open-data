# NWS requires an identifying User-Agent. Add a contact URL or email before production use.
NWS_USER_AGENT=WeatherSignalOpenData/1.0 (contact: your-email@example.com)

# Copy these from Upstash Redis REST API.
UPSTASH_REDIS_REST_URL=https://your-upstash-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token
UPSTASH_CACHE_KEY=weather-signal:latest
CACHE_TTL_SECONDS=604800

# Public deployment base URL.
SITE_URL=https://your-site.netlify.app

# GitHub Actions uses this only to ask Netlify to rebuild after collection.
NETLIFY_BUILD_HOOK_URL=

# Optional, transparent monetization configuration. Omit both values to keep the site non-monetized.
PAYPAL_ME_LINK=
SPONSOR_URL=
SPONSOR_LABEL=
